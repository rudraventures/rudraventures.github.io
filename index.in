                    <textarea name="Message" rows="5" required placeholder="परियोजना विवरण / पूछताछ" class="w-full bg-navy-dark border border-gold/20 rounded-md px-5 py-4 text-xs text-white focus:border-gold outline-none transition-all"></textarea>
                    
                    <button type="submit" data-translate="btn-submit" class="w-full py-5 bg-gold text-navy-dark font-bold text-[11px] uppercase tracking-[0.3em] rounded-md shadow-xl hover:bg-gold-light hover:shadow-gold/20 transition-all transform hover:-translate-y-1">सुरक्षित पूछताछ भेजें</button>
