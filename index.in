    <script>
        let currentLang = 'hi';

        const translations = {
            en: {
                "nav-about": "Legacy", "nav-sectors": "Verticals", "nav-contact": "Inquiry",
                "hero-tag": "A Heritage of Trust & Excellence", "hero-title-1": "Strategic Vision.", "hero-title-2": "Legacy Results.",
                "hero-desc": "Bespoke advisory in real estate, certified yoga & wellness correction, and elite global commerce gateways.",
                "cta-explore": "Explore Verticals", "about-badge": "Executive Summary", "about-title": "About Rudra Ventures",
                "about-para1": "At Rudra Ventures, we are building across three vital segments: trusted real estate advisory, professional wellness & lifestyle coaching, and an upcoming global export vertical.",
                "stat-registered": "Registered Advisory", "stat-quality": "Standard Compliance",
                "pill-1": "Rudra Realty", "pillar1-desc": "Strategic land consultancy with full documentation support and title verification.",
                "pill-2": "Rudra Wellness", "pillar2-desc": "Authorized posture correction and certified wellness coaching for elite lifestyle.",
                "pill-3": "Rudra Exporters", "pillar3-desc": "An upcoming global supply channel for premium agricultural commodities and raw merchandise — launching soon.",
                "badge-soon": "Launching Soon", "exp-detail": "Focusing on Grade-A agricultural commodities and verified raw materials for international supply chains.",
                "well-detail": "Yoga posture correction and stress therapy under Govt. certified guidance.",
                "real-detail": "Strategic land consultancy for residential & commercial portfolios with clear title verification.",
                "contact-title": "Connect with Executives", "contact-desc": "Secure corporate channel for specific inquiries regarding our realty, wellness, or export pipelines.",
                "opt-choose": "Select Vertical", 
                "opt-realty": "Strategic Realty Advisory (realty@rudraventures.in)", 
                "opt-wellness": "Wellness Division (care@rudraventures.in)", 
                "opt-exp": "Rudra Exporters Pipeline (exports@rudraventures.in)",
                "btn-submit": "Submit Secure Inquiry", "cta-interest": "Register Interest →"
            },
            hi: {
                "nav-about": "परिचय", "nav-sectors": "कार्यक्षेत्र", "nav-contact": "पूछताछ",
                "hero-tag": "विश्वास और उत्कृष्टता की विरासत", "hero-title-1": "रणनीतिक विजन।", "hero-title-2": "स्थायी परिणाम।",
                "hero-desc": "रियल एस्टेट में विशेषज्ञ सलाह, प्रमाणित वेलनेस सुधार और वैश्विक वाणिज्य द्वार।",
                "cta-explore": "सेक्टर्स देखें", "about-badge": "कार्यकारी सारांश", "about-title": "रुद्र वेंचर्स के बारे में",
                "about-para1": "रुद्र वेंचर्स में, हम तीन महत्वपूर्ण क्षेत्रों का निर्माण कर रहे हैं: विश्वसनीय रियल एस्टेट रणनीतिक परामर्श, पेशेवर वेलनेस और लाइफस्टाइल कोचिंग, और एक आगामी वैश्विक निर्यात वर्टिकल।",
                "stat-registered": "पंजीकृत सलाहकार", "stat-quality": "मानक अनुपालन",
                "pill-1": "रुद्र रियल्टी", "pillar1-desc": "पूर्ण दस्तावेज़ीकरण सहायता और टाइटल सत्यापन के साथ रणनीतिक भूमि परामर्श।",
                "pill-2": "रुद्र वेलनेस", "pillar2-desc": "विशिष्ट जीवनशैली के लिए अधिकृत पोस्चर सुधार और प्रमाणित योग एवं स्वास्थ्य कोचिंग।",
                "pill-3": "रुद्र एक्सपोर्टर्स", "pillar3-desc": "प्रीमियम कृषि उपज और कच्चे माल के लिए एक आगामी वैश्विक आपूर्ति चैनल — जल्द ही लॉन्च हो रहा है।",
                "badge-soon": "शीघ्र लॉन्च", "exp-detail": "अंतर्राष्ट्रीय आपूर्ति श्रृंखलाओं के लिए ग्रेड-ए कृषि वस्तुओं और सत्यापित कच्चे माल पर ध्यान केंद्रित करना।",
                "well-detail": "योग एवं शारीरिक मुद्रा सुधार और तनाव चिकित्सा सरकारी प्रमाणित मार्गदर्शन के तहत।",
                "real-detail": "स्पष्ट टाइटल सत्यापन के साथ आवासीय और वाणिज्यिक पोर्टफोलियो के लिए रणनीतिक भूमि परामर्श।",
                "contact-title": "अधिकारियों से जुड़ें", "contact-desc": "हमारी रियल्टी, वेलनेस या एक्सपोर्ट पाइपलाइनों के बारे में विशिष्ट पूछताछ के लिए सुरक्षित चैनल।",
                "opt-choose": "क्षेत्र चुनें", 
                "opt-realty": "रणनीतिक रियल्टी परामर्श (realty@rudraventures.in)", 
                "opt-wellness": "वेलनेस प्रभाग (care@rudraventures.in)", 
                "opt-exp": "रुद्र एक्सपोर्टर्स पाइपलाइन (exports@rudraventures.in)",
                "btn-submit": "सुरक्षित पूछताछ भेजें", "cta-interest": "रुचि दर्ज करें →"
            }
        };

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        function switchLanguage(lang) {
            currentLang = lang;
            const placeholders = {
                hi: { name: 'पूरा नाम', email: 'ईमेल पता', message: 'परियोजना विवरण / पूछताछ' },
                en: { name: 'Full Name', email: 'Email Address', message: 'Project Details / Inquiry' }
            };
            
            document.querySelector('input[name="Name"]').placeholder = placeholders[lang].name;
            document.querySelector('input[name="email"]').placeholder = placeholders[lang].email;
            document.querySelector('textarea[name="Message"]').placeholder = placeholders[lang].message;

            document.querySelectorAll('[data-translate]').forEach(el => {
                const key = el.getAttribute('data-translate');
                if(translations[lang][key]) el.innerText = translations[lang][key];
            });
            
            document.getElementById('lang-hi').className = lang === 'hi' ? "px-3 py-1 bg-gold text-navy-dark font-bold transition-all" : "px-3 py-1 text-gray-400 hover:text-gold transition-all";
            document.getElementById('lang-en').className = lang === 'en' ? "px-3 py-1 bg-gold text-navy-dark font-bold transition-all" : "px-3 py-1 text-gray-400 hover:text-gold transition-all";
        }

        document.addEventListener("DOMContentLoaded", () => switchLanguage('hi'));

        function toggleModal(type) {
            const container = document.getElementById('modal-container');
            const content = document.getElementById('modal-content');
            if(!type) { container.classList.add('hidden'); return; }
            
            container.classList.remove('hidden');
            if(type === 'privacy') {
                content.innerHTML = `<h5 class="text-gold font-serif text-2xl font-bold mb-6">Privacy Policy (DPDP Act 2023)</h5><p>Rudra Ventures operates under the strict guidelines of the Digital Personal Data Protection Act (2023). We collect essential advisory data only. Your information is encrypted and never shared with unauthorized third-party brokers. Users retain the right to data erasure by contacting info@rudraventures.in.</p>`;
            } else {
                content.innerHTML = `<h5 class="text-gold font-serif text-2xl font-bold mb-6">Terms of Use</h5><p>Services offered by Rudra Realty are strategic advisories based on prevailing market data. Independent verification is recommended for all high-value transactions. Rudra Wellness programs are certified lifestyle corrections and should not be treated as clinical surgical medical advice.</p>`;
            }
        }

        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const form = this;
            const btn = form.querySelector('button[data-translate="btn-submit"]');
            const msgBox = document.getElementById('form-success-msg');
            const msgText = document.getElementById('success-msg-text');
            const rawName = form.querySelector('input[name="Name"]').value;
            const rawEmail = form.querySelector('input[name="email"]').value;
            const escapedName = escapeHtml(rawName);
            const escapedEmail = escapeHtml(rawEmail);
            
            btn.innerText = currentLang === 'hi' ? "प्रसारित हो रहा है..." : "Processing...";
            btn.disabled = true;
            
            fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'Accept': 'application/json' }
            }).then(response => {
                if (response.ok) {
                    msgText.innerHTML = currentLang === 'hi'
                        ? `प्रिय <strong>${escapedName}</strong> (${escapedEmail}), आपका संदेश सफलतापूर्वक भेज दिया गया है। हम जल्द ही आपसे संपर्क करेंगे।`
                        : `Dear <strong>${escapedName}</strong> (${escapedEmail}), your message has been sent successfully. We will contact you shortly.`;
                    msgBox.classList.remove('hidden');
                    form.reset();
                    btn.innerText = currentLang === 'hi' ? "सुरक्षित पूछताछ भेजें" : "Submit Secure Inquiry";
                    btn.disabled = false;
                    setTimeout(() => msgBox.classList.add('hidden'), 8000);
                } else {
                    alert(currentLang === 'hi' ? "संदेश नहीं भेजा जा सका। कृपया info@rudraventures.in पर संपर्क करें।" : "Submission failed. Please contact info@rudraventures.in directly.");
                    btn.innerText = currentLang === 'hi' ? "सुरक्षित पूछताछ भेजें" : "Submit Secure Inquiry";
                    btn.disabled = false;
                }
            }).catch(() => {
                alert(currentLang === 'hi' ? "नेटवर्क त्रुटि। कृपया info@rudraventures.in पर संपर्क करें।" : "Network error. Contact info@rudraventures.in.");
                btn.innerText = currentLang === 'hi' ? "सुरक्षित पूछताछ भेजें" : "Submit Secure Inquiry";
                btn.disabled = false;
            });
        });
    </script>
</body>
</html>
